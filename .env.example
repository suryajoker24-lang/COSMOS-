# ASTRA & COSMOS Configuration

# Assistant Settings
ASTRA_ENABLED=true
ASTRA_DEFAULT_MODE=SCIENTIST

# LLM Provider: "local" (default offline mock), "openai", "anthropic", "gemini"
LLM_PROVIDER=local
LLM_MODEL=gpt-4o
LLM_API_KEY=

# Speech-To-Text Provider: "local" (browser Web Speech), "whisper"
STT_PROVIDER=local
STT_API_KEY=

# Text-To-Speech Provider: "browser" (native Web Speech), "cloud"
TTS_PROVIDER=browser
TTS_API_KEY=

# Astronomical Plate Solver: "local" (astrometry engine)
PLATE_SOLVER_PROVIDER=local
PLATE_SOLVER_API_KEY=

# Telescope Mount: "mock" (simulation), "ascom", "indi"
TELESCOPE_PROVIDER=mock
TELESCOPE_HOST=127.0.0.1
TELESCOPE_PORT=11111
